{
  "name": "solta",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "dev": "npm run build && wrangler dev --config wrangler.jsonc --local --ip 127.0.0.1 --port 8787",
    "build": "vite build",
    "deploy": "npm run build && node scripts/verificar-publicacao.js && wrangler deploy --config wrangler.jsonc",
    "db:local": "wrangler d1 migrations apply solta-db --local",
    "db:remoto": "wrangler d1 migrations apply solta-db --remote",
    "test": "wrangler deploy --config wrangler.jsonc --dry-run --outdir .wrangler/build-check && node --test testes/integracao.test.js"
  },
  "dependencies": {
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-collaboration": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "yjs": "13.6.33"
  },
  "devDependencies": { "vite": "8.0.13", "wrangler": "4.92.0", "miniflare": "4.20260515.0" }
}
