{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "solta",
  "main": "servidor/index.js",
  "compatibility_date": "2026-05-15",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "solta-db",
    "database_id": "00000000-0000-4000-8000-000000000001",
    "migrations_dir": "banco"
  }],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "solta-arquivos" }],
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "SITE_STORAGE_LIMIT_BYTES": "50000000000",
    "UPLOAD_INTERVAL_MS": "7200000",
    "R2_MONTHLY_A_LIMIT": "100000",
    "R2_MONTHLY_B_LIMIT": "500000"
  },
  "observability": { "enabled": false }
}
